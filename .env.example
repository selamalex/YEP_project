# ------------------------------------------------------------------------------
# 2. Server-Side Supabase Configuration (Strictly Private - NEVER expose in client bundles)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (used only on the server/backend for privileged operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. AI Mascot Chatbot Configuration (Google Gemini Free Version)
# ------------------------------------------------------------------------------
# Google Gemini API Key (obtained for free from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model (Defaults to gemini-3.5-flash-lite for free tier speed and reliability)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 4. Optional Custom Backend Microservice URL
# ------------------------------------------------------------------------------
# If deploying the separate 'backend/' folder to Render/Railway, provide its URL here:
# BACKEND_URL=https://your-yep-backend.onrender.com
